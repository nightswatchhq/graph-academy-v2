{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "astro",
  "trailingSlash": true,
  "cleanUrls": false,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/delegators/28-day-delegation-unbonding-period/",
      "destination": "/delegators/undelegation-and-thawing/",
      "permanent": true
    },
    {
      "source": "/delegators/undelegating-and-withdrawing/",
      "destination": "/delegators/undelegation-and-thawing/",
      "permanent": true
    },
    {
      "source": "/certificates/",
      "destination": "/catalogue/",
      "permanent": true
    },
    {
      "source": "/courses/",
      "destination": "/catalogue/",
      "permanent": true
    },
    {
      "source": "/docs-sub/faq-about-the-graph/",
      "destination": "/start/faq/",
      "permanent": true
    },
    {
      "source": "/docs-sub/index/",
      "destination": "/catalogue/",
      "permanent": true
    },
    {
      "source": "/docs-sub/",
      "destination": "/catalogue/",
      "permanent": true
    },
    {
      "source": "/ecosystem/ecosystem-participants/",
      "destination": "/ecosystem/",
      "permanent": true
    },
    {
      "source": "/grants/",
      "destination": "/governance/council-and-foundation/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/changelog/",
      "permanent": true
    },
    {
      "source": "/videos/",
      "destination": "/catalogue/",
      "permanent": true
    },
    {
      "source": "/video-guides/",
      "destination": "/catalogue/",
      "permanent": true
    },
    {
      "source": "/podcasts/",
      "destination": "/ecosystem/",
      "permanent": true
    },
    {
      "source": "/events/",
      "destination": "/ecosystem/",
      "permanent": true
    },
    {
      "source": "/official-docs/",
      "destination": "/catalogue/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/contribute/",
      "permanent": true
    },
    {
      "source": "/office-hours/",
      "destination": "/ecosystem/",
      "permanent": true
    },
    {
