---
import Mark from './Mark.astro';
import { OUTBOUND } from '../lib/site';
import { COLLECTIONS } from '../lib/paths';

const path = Astro.url.pathname;

/**
 * Two disclosures and two flat links, rather than a flat list of nine. The old
 * nav promoted a few collections and left the rest out, which reads as an
 * accident rather than an editorial choice, and it duplicated the catalogue's
 * whole job besides.
 *
 * The paths are read from COLLECTIONS so the menu cannot drift from the
 * site. Built on <details> deliberately: it opens, closes, takes focus and
 * answers the keyboard with no JavaScript at all. The script below only adds
 * the two conveniences a native disclosure does not have, closing on Escape
 * and on a click elsewhere.
 */
const learn = [
  { href: '/catalogue/', label: 'The whole catalogue', note: 'Everything held here' },
  ...COLLECTIONS.map((c) => ({ href: `/${c.hub}/`, label: c.title, note: c.blurb })),
];

const reference = [
  { href: '/glossary/', label: 'Glossary', note: 'Every term, including the obsolete ones' },
  { href: '/parameters/', label: 'Parameters', note: 'Every number, sourced and dated' },
  { href: '/parameters/history/', label: 'Parameter history', note: 'What each value was, and what changed it' },
];

const flat = [
  { href: '/diagnose/', label: 'Diagnose' },
  { href: '/dispatches/', label: 'Dispatches' },
];

/**
 * A link is current only on its own page. A prefix test would light up both
 * /parameters/ and /parameters/history/ while the reader is on the second,
 * which reads as the menu not knowing where you are.
 */
const on = (href: string) => path === href;
/** A menu, unlike a link, is current anywhere inside it. */
const inMenu = (items: { href: string }[]) =>
  items.some((i) => path === i.href || path.startsWith(i.href));
---
<a class="skip" href="#main">Skip to content</a>
<header class="site">
  <nav class="nav" aria-label="Main">
    <a class="brand" href="/">
      <Mark />
      <span class="brand-name">The Graph <b>Academy</b></span>
    </a>
    <div class="nav-links">
      <details class="menu" data-menu>
        <summary aria-current={inMenu(learn) ? 'true' : undefined}>Learn</summary>
        <div class="menu-panel" role="group" aria-label="Collections">
          {learn.map((l) => (
            <a href={l.href} aria-current={on(l.href) ? 'page' : undefined}>
              <span class="menu-label">{l.label}</span>
              <span class="menu-note">{l.note}</span>
            </a>
          ))}
        </div>
      </details>

      {flat.map((l) => (
        <a class="nav-flat" href={l.href} aria-current={on(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}

      <details class="menu" data-menu>
        <summary aria-current={inMenu(reference) ? 'true' : undefined}>Reference</summary>
        <div class="menu-panel menu-panel--end" role="group" aria-label="Reference">
          {reference.map((l) => (
            <a href={l.href} aria-current={on(l.href) ? 'page' : undefined}>
              <span class="menu-label">{l.label}</span>
              <span class="menu-note">{l.note}</span>
            </a>
          ))}
        </div>
      </details>

      <a class="out nav-flat" href={OUTBOUND.docs} rel="external noopener">Docs</a>
    </div>
    <div class="nav-tools">
      <a class="icon-btn" href="/search/" aria-label="Search the Academy">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" aria-hidden="true">
          <circle cx="10.5" cy="10.5" r="6.5" /><path d="m15.5 15.5 4 4" />
        </svg>
      </a>
      <button class="icon-btn" id="theme-toggle" type="button"
              aria-label="Switch between the dark and light theme">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
             stroke-linecap="round" aria-hidden="true">
          <path d="M20 13.4A8.2 8.2 0 0 1 10.6 4a8.2 8.2 0 1 0 9.4 9.4Z" />
        </svg>
      </button>
    </div>
  </nav>
</header>

<script is:inline>
  // Everything below is convenience. With this script removed the menus still
  // open, close, and work from the keyboard, because they are <details>.
  (function () {
    var menus = Array.prototype.slice.call(document.querySelectorAll('[data-menu]'));
    if (!menus.length) return;

    function closeAll(except) {
      menus.forEach(function (m) { if (m !== except) m.open = false; });
    }

    menus.forEach(function (m) {
      // One at a time. Two open panels overlap each other on a narrow header.
      m.addEventListener('toggle', function () { if (m.open) closeAll(m); });
    });

    document.addEventListener('click', function (e) {
      if (!menus.some(function (m) { return m.contains(e.target); })) closeAll(null);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Escape') return;
      var open = menus.filter(function (m) { return m.open; });
      if (!open.length) return;
      closeAll(null);
      // Escape should leave focus somewhere sensible, which is the summary the
      // reader opened rather than wherever they had got to inside the panel.
      var s = open[0].querySelector('summary');
      if (s) s.focus();
    });
  })();
</script>
