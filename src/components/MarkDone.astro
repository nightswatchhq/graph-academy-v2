---
interface Props { id: string }
const { id } = Astro.props;
---
<div class="mark-done" data-markdone={id}>
  <button class="check-item" type="button" aria-pressed="false" style="max-width: 26rem;">
    <span class="tick" aria-hidden="true"></span>
    <span>Mark this lesson done</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-markdone]').forEach((el) => {
    const id = el.dataset.markdone!;
    const key = 'academy-done';
    const read = (): string[] => {
      try { return JSON.parse(localStorage.getItem(key) ?? '[]'); } catch { return []; }
    };
    const btn = el.querySelector<HTMLButtonElement>('.check-item')!;
    const label = btn.querySelector('span:last-child')!;
    const paint = (on: boolean) => {
      btn.setAttribute('aria-pressed', String(on));
      label.textContent = on ? 'Done. Click to unmark.' : 'Mark this lesson done';
    };
    paint(read().includes(id));
    btn.addEventListener('click', () => {
      const on = btn.getAttribute('aria-pressed') !== 'true';
      const next = on ? [...new Set([...read(), id])] : read().filter((x) => x !== id);
      try { localStorage.setItem(key, JSON.stringify(next)); } catch { /* storage blocked */ }
      paint(on);
    });
  });
</script>
