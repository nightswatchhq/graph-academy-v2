---
import Base from '../layouts/Base.astro';
import Search from 'astro-pagefind/components/Search';
---
<Base
  title="Search"
  description="Search every entry, glossary term and parameter on the Academy."
  noindex={true}
>
  <section class="wrap" style="padding-block: clamp(2.8rem, 6vw, 4rem) 0;">
    <p class="kicker">Search</p>
    <h1 style="max-width: 14ch;">Find it.</h1>
    <p class="section-lede" style="margin-top: 1.1rem;">
      Full text across every entry. The index is built at deploy time and served as
      static files, so nothing you type here leaves your browser.
    </p>
  </section>
  <section class="wrap" style="padding-top: 2rem;">
    <div style="max-width: 44rem;">
      <Search id="pagefind-ui" className="pagefind-ui" uiOptions={{ showImages: false, showSubResults: true }} />
    </div>
    <noscript>
      <p class="section-lede" style="margin-top: 1.6rem;">
        Search needs JavaScript. Without it, the <a href="/catalogue/">paths index</a> and
        the <a href="/glossary/">glossary</a> are the two places to browse from, and both
        work fully without scripting.
      </p>
    </noscript>
  </section>
</Base>
