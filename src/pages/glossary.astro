---
import Base from '../layouts/Base.astro';
import { groupedGlossary, slugify } from '../lib/glossary';
import { param } from '../lib/params';

const groups = groupedGlossary();
const total = groups.reduce((n, g) => n + g.terms.length, 0);
---
<Base
  title="Glossary"
  description="Every term this protocol uses, defined once, including the obsolete ones you will still meet in older material."
>
  <section class="wrap" style="padding-block: clamp(2.8rem, 6vw, 4.4rem) 2rem;">
    <p class="kicker">Reference</p>
    <h1 style="max-width: 14ch;">Glossary</h1>
    <p class="section-lede" style="margin-top: 1.2rem; font-size: 1.05rem;">
      {total} terms, defined once. Terms marked obsolete are kept deliberately: you will
      meet them in material written before Arbitrum or before Horizon, and knowing they
      are dead is more useful than not finding them at all.
    </p>
    <nav class="gloss-nav" style="margin-top: 2rem;" aria-label="Jump to letter">
      {groups.map((g) => <a href={`#letter-${g.letter}`}>{g.letter}</a>)}
    </nav>
  </section>

  <section class="wrap" style="padding-top: 0;">
    <div style="max-width: 46rem;">
      {groups.map((g) => (
        <div class="gloss-group" id={`letter-${g.letter}`}>
          <p class="gloss-letter">{g.letter}</p>
          {g.terms.map((t) => (
            <div class="gloss-item" id={slugify(t.term)}>
              <div>
                <span class="gloss-term">{t.term}</span>
                {t.aliases && <span class="gloss-alias">{t.aliases.join(' · ')}</span>}
                {t.obsolete && <span class="tag tag--rust" style="margin-left: 10px;">obsolete</span>}
              </div>
              <p class="gloss-def">{t.def}</p>
              <p class="gloss-more">
                {t.more && <a href={t.more}>Read the entry</a>}
                {t.more && t.param && <span style="color: var(--text-faint);"> · </span>}
                {t.param && (
                  <a href={`/parameters/#${t.param}`}>
                    {param(t.param).label}: {param(t.param).display}
                  </a>
                )}
              </p>
            </div>
          ))}
        </div>
      ))}
    </div>
  </section>
</Base>
