---
import Base from '../layouts/Base.astro';
import { OUTBOUND } from '../lib/site';

const groups = [
  {
    kicker: 'Official',
    title: 'Where the reference lives',
    items: [
      { name: 'The Graph documentation', url: OUTBOUND.docs, note: 'Procedures, CLI reference, configuration. The source of truth for how, maintained by the people shipping the code.' },
      { name: 'Graph Explorer', url: OUTBOUND.explorer, note: 'Browse subgraphs, indexers and protocol state. Delegate and curate from here.' },
      { name: 'Subgraph Studio', url: OUTBOUND.studio, note: 'Develop and deploy subgraphs, and manage API keys.' },
      { name: 'The community forum', url: OUTBOUND.forum, note: 'Where GIPs are discussed and where operational problems get diagnosed by people who have had them.' },
      { name: 'GIP repository', url: OUTBOUND.gips, note: 'Every proposal, with its rationale. The best design documentation this protocol has.' },
    ],
  },
  {
    kicker: 'Data',
    title: 'Where the live numbers are',
    items: [
      { name: 'Lodestar', url: OUTBOUND.lodestar, note: 'Independent dashboard: indexer comparison, delegation calculator, POI explorer, curation data, protocol state and payment flows.' },
      { name: 'Lodestar: compare indexers', url: 'https://www.lodestar-dashboard.com/delegate', note: 'The delegator decision, with the numbers this site deliberately does not carry.' },
      { name: 'Lodestar: indexing status', url: 'https://www.lodestar-dashboard.com/indexing-status', note: 'Deployment health and POI comparison across indexers.' },
    ],
  },
];
---
<Base
  title="Ecosystem"
  description="Where to go for reference material, live data, and the people who can answer a question this site cannot."
>
  <section class="wrap" style="padding-block: clamp(2.8rem, 6vw, 4.4rem) 0;">
    <p class="kicker">Ecosystem</p>
    <h1 style="max-width: 16ch;">This site is one of three things you need.</h1>
    <p class="section-lede" style="margin-top: 1.2rem; font-size: 1.05rem;">
      The Academy explains why the protocol is shaped as it is. The documentation carries
      how to do things. Dashboards carry what is true right now. Any one of the three
      alone will mislead you.
    </p>
  </section>

  {groups.map((g) => (
    <section class="wrap" style="padding-block: 3rem 0;">
      <p class="kicker">{g.kicker}</p>
      <h2 style="max-width: 20ch;">{g.title}</h2>
      <div style="max-width: 46rem; margin-top: 1.8rem;">
        {g.items.map((i) => (
          <div style="padding-block: 18px; border-bottom: 1px solid var(--border);">
            <a class="out" href={i.url} rel="external noopener" style="font-weight: 600; font-size: 1rem;">{i.name}</a>
            <p style="color: var(--text-muted); margin-top: 6px; font-size: 0.94rem;">{i.note}</p>
          </div>
        ))}
      </div>
    </section>
  ))}

  <section class="wrap">
    <p class="kicker">A note on what is listed</p>
    <h2 style="max-width: 22ch;">Short, on purpose.</h2>
    <p class="section-lede" style="margin-top: 1.1rem;">
      A long list of every tool anyone has built would go stale within months and would
      not help you choose. These are the places the lessons on this site actually send
      you. If something belongs here and is missing,
      <a href="/contribute/">say so</a>, with a sentence on what it does that the
      existing entries do not.
    </p>
  </section>
</Base>
