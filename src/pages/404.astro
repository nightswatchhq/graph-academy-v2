---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="No page at this address." noindex={true}>
  <section class="wrap" style="padding-block: clamp(3rem, 7vw, 5rem) 0;">
    <p class="kicker">404</p>
    <h1 style="max-width: 16ch;">No page at this address.</h1>
    <p class="section-lede" style="margin-top: 1.3rem;">
      Either the link is wrong or the page moved. The two most useful places to start
      again are the curriculum and the glossary, and both work without JavaScript.
    </p>
    <div class="btn-row" style="margin-top: 2rem;">
      <a class="btn btn-primary" href="/catalogue/">Browse the paths</a>
      <a class="btn btn-ghost" href="/glossary/">Glossary</a>
      <a class="btn btn-ghost" href="/search/">Search</a>
    </div>
  </section>
</Base>
