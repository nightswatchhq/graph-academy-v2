---
import Base from '../layouts/Base.astro';
import { PATHS, lessonsForHub, pathDuration } from '../lib/paths';

const rows = await Promise.all(
  PATHS.map(async (p) => ({
    meta: p,
    count: (await lessonsForHub(p.hub)).length,
    minutes: await pathDuration(p.hub),
  })),
);
const totalLessons = rows.reduce((n, r) => n + r.count, 0);
const totalMinutes = rows.reduce((n, r) => n + r.minutes, 0);
---
<Base
  title="Learning paths"
  description="Seven role-based paths through The Graph, from what the protocol is for to running infrastructure on it."
>
  <section class="wrap" style="padding-block: clamp(2.8rem, 6vw, 4.4rem) 0;">
    <p class="kicker">The curriculum</p>
    <h1 style="max-width: 15ch;">Pick the role you actually came here for.</h1>
    <p class="section-lede" style="margin-top: 1.2rem; font-size: 1.05rem;">
      Each path is a sequence, not a pile of articles. Every lesson carries the date it
      was last checked and the sources it was checked against, and each path ends with a
      checkpoint you can be wrong on at no cost.
    </p>
    <div class="lesson-meta" style="margin-top: 1.6rem;">
      <span class="m"><b>{rows.length}</b> paths</span>
      <span class="m"><b>{totalLessons}</b> lessons</span>
      <span class="m"><b>{Math.round(totalMinutes / 60)}</b> hours end to end</span>
    </div>
    <p class="section-lede" style="margin-top: 1.4rem;">
      Progress is remembered in this browser alone. No account, no sign-in, nothing sent
      anywhere.
    </p>
  </section>

  <section class="wrap" style="padding-top: 2.6rem;">
    <div class="roles">
      {rows.map((r) => (
        <a class="role-card" href={`/${r.meta.hub}/`}>
          <span class="tag tag--rust">{r.meta.kicker}</span>
          <span class="role-name">{r.meta.title}</span>
          <p>{r.meta.blurb}</p>
          <span class="role-meta">{r.count} lessons · {r.minutes} min · {r.meta.difficulty}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap">
    <p class="kicker">If you are new</p>
    <h2 style="max-width: 18ch;">Start at the beginning. It is an hour.</h2>
    <p class="section-lede" style="margin-top: 1.1rem;">
      The Foundations path assumes you know what a blockchain is and nothing else about
      this protocol. Every other path assumes you have done it, or already know the
      equivalent.
    </p>
    <div class="btn-row" style="margin-top: 1.8rem;">
      <a class="btn btn-primary" href="/start/">Start with Foundations</a>
      <a class="btn btn-ghost" href="/glossary/">Or browse the glossary</a>
    </div>
  </section>
</Base>
