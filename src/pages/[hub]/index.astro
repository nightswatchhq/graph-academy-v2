---
import Base from '../../layouts/Base.astro';
import { COLLECTIONS, collectionOf, sectionsInCollection, entriesInCollection, collectionReadingTime } from '../../lib/paths';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  return COLLECTIONS.map((c) => ({ params: { hub: c.hub } }));
}

const { hub } = Astro.params;
const meta = collectionOf(hub!);
const sections = await sectionsInCollection(hub!);
const entries = await entriesInCollection(hub!);
const minutes = await collectionReadingTime(hub!);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Collection',
  name: `${meta.path}`,
  description: meta.lede,
  isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  inLanguage: 'en',
  numberOfItems: entries.length,
};
---
<Base title={meta.title} description={meta.lede} jsonLd={jsonLd}>
  <section class="wrap" style="padding-block: clamp(3rem, 7vw, 5rem) 0;">
    <p class="kicker">Collection</p>
    <h1 class="display">{meta.title}</h1>
    <p class="section-lede lede-lg">{meta.lede}</p>
    <div class="entry-meta" style="margin-top: 1.8rem;">
      <span class="m"><b>{entries.length}</b> entries</span>
      <span class="m"><b>{minutes}</b> min to read through</span>
      <span class="m">{meta.difficulty}</span>
    </div>
  </section>

  <hr class="divider" style="margin-top: clamp(2.6rem, 5vw, 3.6rem);" />

  <section class="wrap" style="padding-block: clamp(2.4rem, 5vw, 3.4rem) 0;">
    <div class="shelves">
      {sections.map((s, si) => (
        <div class="shelf">
          <div class="shelf-head">
            <span class="shelf-num">{String(si + 1).padStart(2, '0')}</span>
            <h2>{s.name}</h2>
          </div>
          <ol class="entry-list">
            {s.entries.map((e) => (
              <li>
                <a class="entry-row" href={`/${e.id}/`}>
                  <span class="rtitle">{e.data.title}</span>
                  <span class="rsummary">{e.data.summary}</span>
                  <span class="rmeta"><b>{e.data.time_minutes}</b> min</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </section>

  <section class="wrap">
    <p class="kicker">Elsewhere</p>
    <h2 class="display-sm">This collection explains why. Two other places carry the rest.</h2>
    <div class="cta-row" style="margin-top: 1.8rem;">
      <a class="cta-card out" href={meta.docs.url} rel="external noopener">
        <span class="cta-label">The procedure</span>
        <span>{meta.docs.label}</span>
        <span class="cta-text">
          Exact steps, flags and configuration, maintained by the people who ship the code.
          This site does not duplicate them and never will.
        </span>
      </a>
      {meta.live && (
        <a class="cta-card out" href={meta.live.url} rel="external noopener">
          <span class="cta-label">The live numbers</span>
          <span>{meta.live.label}</span>
          <span class="cta-text">
            Nothing here updates on its own. Live stake, signal, fees and indexer
            performance come from a dashboard reading the network.
          </span>
        </a>
      )}
    </div>
  </section>
</Base>
