---
import LessonLayout from '../../layouts/LessonLayout.astro';
import { getCollection, render } from 'astro:content';
import { pathByHub, neighbours, hubOf } from '../../lib/paths';
import * as MDX from '../../components/mdx';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => !data.draft);
  return lessons.map((lesson) => {
    const [hub, slug] = lesson.id.split('/');
    return { params: { hub, slug }, props: { lesson } };
  });
}

const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const meta = pathByHub(hubOf(lesson));
const { prev, next, index, total } = await neighbours(lesson);
---
<LessonLayout lesson={lesson} meta={meta} headings={headings} prev={prev} next={next} index={index} total={total}>
  <Content components={MDX} />
</LessonLayout>
