---
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getCollection, render } from 'astro:content';
import { collectionOf, neighbours, hubOf, relatedEntries } from '../../lib/paths';
import * as MDX from '../../components/mdx';

export async function getStaticPaths() {
  const entries = await getCollection('entries', ({ data }) => !data.draft);
  return entries.map((entry) => {
    const [hub, slug] = entry.id.split('/');
    return { params: { hub, slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const meta = collectionOf(hubOf(entry));
const { prev, next, index, total } = await neighbours(entry);
const related = await relatedEntries(entry);
---
<EntryLayout
  entry={entry}
  meta={meta}
  headings={headings}
  prev={prev}
  next={next}
  index={index}
  total={total}
  related={related}
>
  <Content components={MDX} />
</EntryLayout>
